# Backend
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=ALOO_Franchise_CMS;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=your_sql_server_password
# Optional in local development. In production, use a separate DDL account for Flyway.
DB_MIGRATION_USERNAME=sa
DB_MIGRATION_PASSWORD=your_sql_server_password
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Set true for local Vite only. Keep false in production.
CORS_INCLUDE_LOCALHOST=true
RATE_LIMIT_BACKEND=memory

# Redis is only used when RATE_LIMIT_BACKEND=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# Google OAuth login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback

# Password change OTP
PASSWORD_CHANGE_OTP_TTL_MINUTES=10

# Live-chat automatic replies
CHAT_AUTO_ENABLED=true
CHAT_AUTO_SENDER_NAME=ALOO Support
CHAT_AUTO_WELCOME_MESSAGE=Xin chao! ALOO co the ho tro gi cho ban?
CHAT_AUTO_RECEIVED_MESSAGE=ALOO da nhan tin nhan va se phan hoi som.

# Comma-separated emails allowed to become CMS admins (Gmail OK).
# Production keeps ADMIN_EMAIL_WHITELIST_REQUIRED=true (backend default).
ADMIN_EMAIL_WHITELIST=founder@gmail.com,manager@gmail.com
ADMIN_EMAIL_WHITELIST_REQUIRED=false

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_BYTES=5242880

# Email notifications (optional — password change alerts)
MAIL_ENABLED=false
MAIL_FROM=noreply@aloo.vn
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
